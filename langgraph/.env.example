# ==================== Required API Keys ====================

# OpenAI API Key (Required for LLM operations)
OPENAI_API_KEY=your_openai_api_key

# Tavily API Key (Required for web search)
TAVILY_API_KEY=your_tavily_api_key

# ==================== Optional API Keys ====================

# Midjourney Proxy (Optional: For Midjourney image generation)
MIDJOURNEY_PROXY_BASE_URL=https://your-midjourney-proxy.com

# PixelHub (Optional: For image search)
PIXELHUB_API_URL=http://your-pixelhub-server:8084/api/v1

# Google Gemini (Optional: For Nanobanana text+image generation and Veo video generation)
GOOGLE_API_KEY=your_google_api_key

# Tencent Cloud COS (Optional: For uploading generated images/videos)
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-guangzhou
COS_BUCKET=your_bucket_name

# Volcengine (Optional: For alternative video generation)
VOLCENGINE_ACCESS_KEY=your_volcengine_access_key
VOLCENGINE_SECRET_KEY=your_volcengine_secret_key

# ==================== LangSmith Tracing (Optional) ====================

# LangSmith API Key (Optional: For tracing and debugging)
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ad-agent

# ==================== Workflow Configuration ====================

# Video Generation (Set to "true" to enable video generation, "false" to only generate prompts)
GENERATE_VIDEO=false

# Video Model (Choose: "veo", "kling", or "seedance")
VIDEO_MODEL=veo
